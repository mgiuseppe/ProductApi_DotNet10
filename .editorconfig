root = true

# Must match .gitattributes: without it dotnet format expects the OS default (CRLF on Windows)
[*]
end_of_line = lf

[*.cs]
# Unnecessary using directives: a warning, so an error with -warnaserror in CI
dotnet_diagnostic.IDE0005.severity = warning

# EF Core migrations are generated code
[src/Infrastructure/Migrations/**.cs]
generated_code = true
