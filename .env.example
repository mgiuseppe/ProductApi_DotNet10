# Copy to .env to override the host ports published by docker-compose.yml.
# If you change POSTGRES_PORT, MONGO_PORT or OTLP_PORT, update src/Api/appsettings.Development.json too (used by F5).
POSTGRES_PORT=5432
MONGO_PORT=27017
DASHBOARD_PORT=18888
OTLP_PORT=4317
API_PORT=8080

# Used by the containerized API for /orders/{id}/summary (F5 reads it from user-secrets instead)
OPENAI_API_KEY=
